{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taushsampley.com/humanities/food/ingredient.schema.json",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "ingredients": { "type": "array", "items": { "$ref": "https://taushsampley.com/humanities/food/ingredients.schema.json" } },
    "inception": { "$ref": "https://taushsampley.com/humanities/history/date.schema.json" }
  },
  "required": [
    "name"
  ]
}